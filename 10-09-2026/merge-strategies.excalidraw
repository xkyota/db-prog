      "boundElements": null,
      "updated": 1789032251214,
      "link": null,
      "locked": false,
      "text": "Octopus merge is used for merging more than two branches\nsimultaneously. It’s less common and typically used for\nautomated merges involving multiple feature branches.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Octopus merge is used for merging more than two branches simultaneously. It’s less common and typically used for automated merges involving multiple feature branches.",
      "autoResize": false,
      "lineHeight": 1.25
    }
