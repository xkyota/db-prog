      "isDeleted": false,
      "boundElements": null,
      "updated": 1789032192207,
      "link": null,
      "locked": false,
      "text": "Recursive merge is Git’s default\nstrategy for merging diverged branches.\nIt creates a merge commit that\ncombines changes while preserving the\nhistory of both branches.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recursive merge is Git’s default strategy for merging diverged branches. It creates a merge commit that combines changes while preserving the history of both branches.",
      "autoResize": false,
      "lineHeight": 1.25
    },
