      "link": null,
      "locked": false,
      "text": "Pragmatic aspect: The program shown in the photo is\ndesigned to track flights in real time. Each object contains\nvaluable information. It displays aircraft and their flight\npaths, as well as flight information.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pragmatic aspect: The program shown in the photo is designed to track flights in real time. Each object contains valuable information. It displays aircraft and their flight paths, as well as flight information.",
      "autoResize": false,
      "lineHeight": 1.25
